[app]
frontend_url=https://example.com
# adres dokumentacji API pokazywany w OpenAPI (router.py).
docs_url=https://galwork.example.com

# FastAPI debug=True (main.py) pokazuje pełne tracebacki w
# odpowiedziach błędów - OK lokalnie, nigdy na produkcji. Nadpisywalne
# zmienną APP_DEBUG=false.
debug=false

# zob. main.py
# dopisz tu każdy nowy frontend dev server.
cors_origins=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
cors_allow_credentials=true


# [db] - connection string - z tych parametrów korzysta db/session.py, alembic/env.py 
[db]
driver=postgresql+psycopg2
name=galwork
host=localhost
port=5432
user=
password=
echo=false

[db-test]
driver=sqlite
name=cm_msqlite.db
host=localhost
port=5432
user=
password=
echo=false

[logging]
level=DEBUG
file=ds.log

[keycloak]
certs_url=https://login.example.com/realms/example/protocol/openid-connect/certs
audience=account
client_id=example
client_secret=xxxxxxxxxxxxxxxxxxxx
admin=jurekw
admin_password=xxxxxxxxxx
server_url=https://login.example.com

# grupy Keycloak uprawnione do zarządzania
admin_groups=wf-admin,galwork-admin
realm_name=example

[Ms365]
TENANT_ID=xxxxxxx
CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
CLIENT_SECRET=
CLIENT2ID=22222222-xxxx
CLIENT2SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_W_ID=xxxxxxxxx
CLIENT_W_SECRET=xxxxxxxxxxxxxxxxx

[AzureClient]
TENANT_ID=xxxxxxxx-xxxxxxxxxxxxxxxxxxx
CLIENT_ID=xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxx
CLIENT_SECRET=Oxxxxxxxxxxxxxxxxxx
AUTHENTICATION_MODE=serviceprincipal
SCOPE=https://graph.microsoft.com/.default
SCOPE_API=api://xxxxxxxxxxxxxxxxxxxx/.default
AUTHORITY_BASE=https://login.microsoftonline.com/
# AUTHORITY=AUTHORITY_BASE+TENANT_ID
CACHE=/tmp/cert_cache.bin

# konektor connector/signius/connector.py (BaseConnector).
[signius]
p12_file=
p12_password=
base_url=https://professional.signius.eu:8900
timeout=30
verify_tls=false

# [mailing] używa też usługa kodów (connector/mailing).
# backend=smtp (domyślnie) albo log - tylko dev: treść (z kodem) do logu.
[mailing]
server=xxxxx
port=587
login=xxxxxxxxxx
password=oxxxxxx
sender=xxxxx<xxxxx@xxxxxxxxxx.pl>

# 2026-11-13: obiegi - kroki systemowe (serviceTask z `handler`, np. podpis
# w Signius) budzone przez scripts/wf_wake.py (scripts/cron_wf.sh).
# system_user - nazwa albo e-mail z tabeli users, w imieniu którego działa
# cron (domyślnie [edr] system_user).
[wf]
system_user=

[edr]
test_db=false
# adresy usług e-Doręczeń i dane rejestracyjne systemu
address=AE:PL-xxxxxxxxxx
key=secret/edr/edr_key.pem
cert=secret/edr/edr_cert.pem
# tryb testowy (EdrConnector(test=True)) - adres ADE i plik
# klucza prywatnego systemu testowego
test_address=AE:PL-91325-95053-SWFEJ-37
test_system_name=TEST123
test_key=secret/edr/edr_test_key.pem
url=https://ow.edoreczenia.gov.pl
realm=EDOR
# nazwa systemu w tokenie RFC7523 oraz nazwa aplikacji używana
# w tokenie dostępu (connector/edoreczenia/edr_token.py)
system_name=TEST123
application_name=GALWORK
# bazowy adres webhooków e-Delivery (dopisywane są /messageCallback itd.)
callback_base_url=https://galwork.example.com/v1/edr
pp_url=https://uaapi-ow.poczta-polska.pl/api/v1
beuis_url=https://edoreczenia.gov.pl/api/beuis/v2
# dane trybu testowego EdrConnector(test=True)
process_model_key=edr-korespondencja
# 2026-11-08: wysyłka (proces edr-wysylka, scripts/edr.py send).
# system_user - nazwa albo e-mail z tabeli users, w imieniu którego działa cron
send_process_model_key=edr-wysylka
send_max_attempts=3
# typy potwierdzeń zamykające "Potwierdzenie doręczenia" (po przecinku; pusto = wyłączone)
delivered_evidence_types=BPOP
system_user=
CSubject=CN = AE:PL-xxxxxxxxxF-29.SYSTEM.GALWORK, O = UNIV, organizationIdentifier = AE:PL-xxxxxxxxx-29, C = PL, ST = PODKARPACKIE, L = NN, postalCode = 99-999, street = xxxxxxxxxxxxxxxx, houseIdentifier = 6

[redmine]
url=https://redmine.example.com
user=admin
password=xxxxxxxxxxxxxxxxxxxxx

[erpnext]
base_url=https://erp.example.com
api_key=xxxxxxxxxxxxxxxxxxxx
api_secret=xxxxxxxxxxxxxxxxxxxx
# widget "Faktury do zatwierdzenia" (wf/services/erpnext_invoice_service.py) -
# nazwy stanu/akcji workflow są w ERPNext konfigurowalne per-instalacja
invoice_doctype=Purchase Invoice
invoice_workflow_field=workflow_state
invoice_pending_states=Pending Approval
invoice_approve_action=Zatwierdź
# grupa Keycloak uprawniona do POST .../approve (zob.
# wf/routers/erpnext_invoice_api.py::require_invoice_approver); dopasowanie
# po leściu ścieżki grupy, jak [keycloak] admin_groups. Puste = nikt.
approver_groups=faktury_zakupu

# reguły akceptacji wniosku zakupowego (wf/services/
# purchase_request_service.py, - progi i flaga PZP są per-instalacja
[zakupy]
# kwota (w walucie `domyslna_waluta`), od której wymagana jest dodatkowa
# akceptacja decydenta budżetowego - niezależnie od rodzaju wydatku.
prog_dodatkowej_akceptacji=10000
# czy organizacja podlega Prawu zamówień publicznych (jednostki sektora
# publicznego) - false dla firmy prywatnej wyłącza cały podobieg "Zamówienie
# publiczne" niezależnie od kwoty (zob. zakupy.md, warunkowość tego obiegu).
pzp_wlaczone=true
# próg PZP (ustawowy dla jednostek sektora publicznego - domyślnie taki sam
# jak prog_dodatkowej_akceptacji, ale to dwa niezależne progi: organizacja
# może chcieć dodatkowej akceptacji przy niższej kwocie niż ustawowy PZP).
prog_pzp=10000
domyslna_waluta=PLN

[n8n]
base_url=https://n8n.example.com
api_key=xxxxxxxxxxxxxxxxxxxx

# konektor do Frappe Education (connector/frappe_education) -
# dziekanat prowadzony we Frappe  Education (../education w tym samym katalogu nadrzędnym).
# Osobna sekcja od [erpnext], bo Education może stać na innym site/hoście
# niż ERPNext (ten sam framework Frappe, różne instalacje). Token API
# (api_key:api_secret) - https://frappeframework.com/docs/user/en/api/rest.
# HASŁA CELOWO PUSTE - zmienne środowiskowe: FRAPPE_EDUCATION_BASE_URL,
# FRAPPE_EDUCATION_API_KEY, FRAPPE_EDUCATION_API_SECRET, FRAPPE_EDUCATION_TIMEOUT.
[edu]
staff_groups=dziekanat,edu-admin

[frappe_education]
base_url=
api_key=
api_secret=
timeout=30
# wywołania z /v1/edu w imieniu zalogowanego użytkownika -
forward_user_token=false

# pieczęć elektroniczna odpowiedzi dziekanatu (edu/services/
# sealing.py, connector/seal/connector.py). Usługa galwork-seal trzyma klucz;
# hub łączy się z jej instancją Valkey jako użytkownik `hub` (ACL w
# galwork-seal/deploy/valkey) i przekazuje tylko skrót dokumentu.
# enabled=false wyłącza pieczętowanie (decyzja w edu-pismo działa jak dotąd).
# models - procesy, których odpowiedzi są pieczętowane; print_format -
# szablon wydruku Frappe dla Student Correspondence (puste = domyślny);
# subfilter - ETSI.CAdES.detached (PAdES, fork endesive) albo puste
# (adbe.pkcs7.detached); tspurl - znacznik czasu (PAdES B-T), puste = brak.
# Hasło: password_file (sekret Dockera) albo password.
# Zmienne środowiskowe: SEAL_ENABLED, SEAL_HOST, SEAL_PORT, SEAL_PASSWORD_FILE,
# SEAL_KEYID, SEAL_PRINT_FORMAT, SEAL_TSPURL itd.
[seal]
enabled=false
models=edu-pismo
host=seal-valkey
port=6379
db=0
ssl=false
username=hub
password=
password_file=
keyid=pieczec
source=edu-pismo
timeout=30
print_format=
letterhead=
subfilter=ETSI.CAdES.detached
tspurl=
reason=Pismo opatrzone pieczęcią elektroniczną uczelni
location=
contact=
attempts=3
retry_delay=30

# magazyn dokumentów Paperless-ngx (connector/paperless/
# connector.py) - zob. connector/edoreczenia/edr_paperless.py. `token` to
# token API Paperless-ngx (Django REST Framework), NIE to samo, co SSO
# Keycloak do interfejsu Paperless dla ludzi. `staging_dir` to katalog na
# pliki czekające na wysyłkę (DocumentVersion.staging_path) - musi być
# zapisywalny przez proces huba/crona. `api_version` (opcjonalnie) -
# numer wersji API wysyłany w nagłówku `Accept` - zostaw puste, żeby nie
# przypinać wersji (serwer użyje swojej domyślnej); ustaw, jeśli trzeba
# wymusić konkretną wersję wspieraną przez dany serwer Paperless-ngx.
# Zmienne środowiskowe: PAPERLESS_BASE_URL, PAPERLESS_TOKEN,
# PAPERLESS_TIMEOUT, PAPERLESS_VERIFY_TLS, PAPERLESS_STAGING_DIR,
# PAPERLESS_API_VERSION.
[paperless]
base_url=
token=
timeout=30
verify_tls=true
staging_dir=data/paperless_staging
api_version=

# Baza Programu Płatnika ZUS (connector/optima/zus.py).
# Konfiguracja jest w tym pliku lub w ENV: ZUS_HOST,
# ZUS_SERVER, ZUS_USER, ZUS_PASSWORD, ZUS_DATABASE, ZUS_PORT.
[zus]
host=
server=
user=
password=
database=
port=
login_timeout=15
appname=hub-zus

# Cache Redis dla skompilowanych formularzy zadań (core/redis_cache.py) -
# GET /v1/wf/tasks/{id}/form filtruje JSON Schema/UI Schema wg macierzy
# `x-permissions` i trzyma wynik w Redis (wf/services/process_service.py::task_form), 
# żeby nie przeliczać go przy każdym wejściu w zadanie. 
# W przeciwieństwie do innych konektorów ma sensowne wartości domyślne - 
# brak tej sekcji/offline Redis NIE blokuje huba, tylko wyłącza cache 
# (liczymy formularz za każdym razem).
# Zmienne środowiskowe:
# REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD, REDIS_TTL.
[redis]
host=localhost
port=6379
db=0
password=
ttl=86400

# baza CDN/Optima (connector/optima/optima.py),
# Konfiguracja może być w zmiennych środowiskowych:
# OPTIMA_HOST, OPTIMA_PORT, OPTIMA_DATABASE, OPTIMA_USER,
# OPTIMA_PASSWORD, OPTIMA_SERVER.
[optima]
host=
port=
database=
user=
password=
server=
# Konektor do e-Talar (connector/etalar/etalar.py). Dzisiejsze M2M API
# (issue/deposit/charge/consent) + miejsce na przyszłe /v3/settlement/*
# z barter.md rozdz. 11-12, kiedy e-Talar je dostanie.
# HASŁA CELOWO PUSTE - zmienne środowiskowe: ETALAR_BASE_URL, ETALAR_API_KEY,
# ETALAR_API_SECRET, ETALAR_TIMEOUT.
[etalar]
base_url=
api_key=
api_secret=
timeout=30

# usługa kodów jednorazowych (konto/) - kod służy tylko do
# założenia konta w Keycloak albo zmiany hasła, nigdy do logowania.
# Zalecane osobne wdrożenie: uvicorn konto.app:app (tylko /v1/konto).
# Sekrety w środowisku: KONTO_SECRET, KONTO_CAPTCHA_SECRET.
# W profilu użytkownika realmu (Keycloak 26) zadeklaruj atrybuty
# phone_number, phone_number_verified, pesel_hmac - edycja tylko przez
# administratora; inaczej Keycloak je pominie. W realmie wyłącz
# samorejestrację i reset hasła (registrationAllowed, resetPasswordAllowed).
[konto]
# kolejność = preferencja kanału przy resecie
channels=sms,email
sms_country_codes=48
default_country_code=48
accounts_per_phone=1
# pula operacji z kodem (założenie konta + odzyskania) na kanał i konto
operations_quota=3
code_length=6
code_ttl=600
max_attempts=5
max_sends=3
resend_interval=60
tickets_per_destination_per_day=5
tickets_per_ip_per_hour=10
sms_per_day=1000
# off | optional | required - w Keycloak tylko HMAC (pesel_hmac)
pesel=off
# email | phone - nazwa użytkownika nowych kont
username=email
group=/kandydaci
# klucz HMAC, min. 32 znaki
secret=
# siteverify hCaptcha / Turnstile / reCAPTCHA; puste = bez CAPTCHA (tylko dev)
# hCaptcha: https://api.hcaptcha.com/siteverify (sekret: KONTO_CAPTCHA_SECRET)
captcha_verify_url=https://api.hcaptcha.com/siteverify
captcha_secret=
captcha_site_key=
login_url=
# true - router także w głównej aplikacji huba (/v1/konto)
mount_in_hub=false

# Keycloak Admin API dla usługi kodów - konto usługowe
# (client_credentials) z uprawnieniami tylko do kandydatów (osobny realm
# albo fine-grained admin permissions na grupę). Sekret w środowisku:
# KEYCLOAK_ADMIN_CLIENT_SECRET.
[keycloak_admin]
server_url=https://login.example.com
realm=kandydaci
client_id=hub-konto
client_secret=
verify_tls=true
timeout=15

# bramka SMS (connector/sms). backend=integracjasms, smsapi
# albo log (tylko dev: treść z kodem do logu). Klucz w środowisku: SMS_TOKEN.
# integracjasms.pl obsługuje tylko polskie numery ([konto] sms_country_codes=48).
[sms]
backend=integracjasms
token=
# nadpis zatwierdzony w bramce (i w rejestrze nadawców UKE); puste = domyślny
sender=
# integracjasms: identyfikator zlecenia (do 64 znaków) i zamiana polskich liter
reference=galwork-konto
transliterate=false
# smsapi: test=true - przyjmuje bez wysyłki
test=false
timeout=15

# login.gov.pl (connector/wk) - weryfikacja tożsamości w
# usłudze kont (konto/wk.py), nie logowanie. Wymaga rejestracji dostawcy
# usługi w Węźle Krajowym: issuer i acs_url muszą zgadzać się z metadanymi
# zgłoszonymi do WK, klucze EC P-256 (podpis i szyfrowanie) z rejestracji.
# Klucze prywatne jako pliki z Kubernetes Secret, nie w obrazie.
[wk]
enabled=false
issuer=
provider_name=
# public - podmiot publiczny (uczelnia publiczna), private - pozostałe
sp_type=public
acs_url=https://konto.example.com/v1/konto/wk/acs
# po weryfikacji przekierowanie do portalu: <portal_url>#wk=<bilet>&cel=...
portal_url=https://portal.example.com/rekrutacja/wk
# środowisko integracyjne; produkcja: https://login.gov.pl/login/SingleSignOnService
# oraz https://login.gov.pl/login-services/idpArtifactResolutionService
sso_url=https://int-podmiotyzewnetrzne.login.gov.pl/login/SingleSignOnService
artifact_resolve_url=https://int-podmiotyzewnetrzne.login.gov.pl/login-services/idpArtifactResolutionService
sign_key=/etc/galwork/wk/sig_ec.key
sign_cert=/etc/galwork/wk/sig_ec.pem
enc_key=/etc/galwork/wk/enc_ec.key
enc_cert=/etc/galwork/wk/enc_ec.pem
# certyfikaty podpisu WK (PEM, po przecinku) - zalecane; w zastępstwie metadane:
idp_certs=
idp_metadata_url=https://int-podmiotyzewnetrzne.login.gov.pl/login/metadata
loa=http://eidas.europa.eu/LoA/substantial
force_authn=true
# enc (jak w sprawdzonej implementacji) albo sign
artifact_sign_key=enc
timeout=15

# kalendarz użytkownika (/v1/kalendarz, kalendarz/).
# Zmienne KALENDARZ_<KLUCZ> mają pierwszeństwo.
[kalendarz]
timezone=Europe/Warsaw
# zakres domyślny (dni) i największy dopuszczalny
domyslne_dni=30
max_dni=400
# łączny limit czasu na zebranie wszystkich źródeł (s)
timeout=15
# kalendarz ogólny uczelni prowadzony w Google Calendar / Microsoft 365 -
# publiczne adresy ICS po przecinku; puste = źródło wyłączone
uczelnia_ics=
uczelnia_nazwa=Kalendarz uczelni
# ważność pobranego pliku ICS (s)
cache_ttl=900
# subskrypcja w Google / Outlook (GET /v1/kalendarz/ics/<token>.ics):
# publiczny adres modułu (puste = z adresu żądania), adres portalu do
# odnośników w opisach, zakres kanału (dni) i czas trzymania gotowego pliku (s)
public_url=
portal_url=
ics_dni_wstecz=30
ics_dni_naprzod=180
ics_cache_ttl=600

# portal kandydata (/v1/rekrutacja, rekrutacja/) - tokeny z
# realmu kandydatów. Frappe (site_config.json, sekcja "keycloak") musi mieć
# ten sam issuer i klienta w allowed_clients.
[rekrutacja]
issuer=https://login.example.com/realms/rekrutacja
# klient(y) portalu kandydata (claim azp), po przecinku
allowed_clients=galwork-portal
# puste - bez sprawdzania aud
audience=
candidate_group=kandydaci
leeway=30

