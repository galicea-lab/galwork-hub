<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_Process_Realizacja_procedury_skreslenia" targetNamespace="http://bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0"
                   xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core">
  <bpmn:process id="Process_Realizacja_procedury_skreslenia" name="Realizacja procedury skreślenia" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Realizacja_procedury_skreslenia">
      <bpmn:lane id="Lane_Rektor" name="Rektor">
        <bpmn:flowNodeRef>Task_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BOS" name="BOS">
        <bpmn:flowNodeRef>Task_04</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Realizacja procedury skreślenia" />
    <bpmn:userTask id="Task_02" name="Wydanie decyzji o skreśleniu z listy studentów" />
    <bpmn:userTask id="Task_04" name="BOS rozpatrzenie odwołania" ><spiffworkflow:property name="lane" value="BOS" /></bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Decyzja i podpis Rektora" ><spiffworkflow:property name="lane" value="Rektor" /></bpmn:userTask>
    <bpmn:userTask id="Task_06" name="Obsługa doręczania" />
    <bpmn:userTask id="Task_05" name="Doręczanie" />
    <bpmn:userTask id="Task_07" name="Archiwum" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Realizacja procedury skreślenia)" default="Flow_2">
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_01" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_4" name="Brak odwołania / rezygnacja" sourceRef="Gateway_01" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_4'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" name="Przekaż odwołanie" sourceRef="Gateway_01" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_5" name="Decyzja o skreśleniu do podpisu" sourceRef="Task_02" targetRef="Task_03" />
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (BOS rozpatrzenie odwołania)" default="Flow_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_04" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_6" name="Wydanie decyzji o skreśleniu" sourceRef="Gateway_03" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_8" name="Prośba o decyzję Rektora" sourceRef="Gateway_03" targetRef="Task_03">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_8'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Decyzja i podpis Rektora)" default="Flow_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_03" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_11" name="Przekazanie decyzji" sourceRef="Gateway_02" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="Wysłanie decyzji o skreśleniu" sourceRef="Gateway_02" targetRef="Task_05" />
    <bpmn:sequenceFlow id="Flow_12" name="Do wysłania" sourceRef="Task_06" targetRef="Task_05" />
    <bpmn:exclusiveGateway id="Gateway_04" name="Wybór ścieżki (Doręczanie)" default="Flow_13" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_05" targetRef="Gateway_04" />
    <bpmn:sequenceFlow id="Flow_13" name="Nie uruchomiono wysyłania" sourceRef="Gateway_04" targetRef="Task_06" />
    <bpmn:sequenceFlow id="Flow_15" name="Problemy z wysłaniem" sourceRef="Gateway_04" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_15'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" name="Wysłanie zakończono pomyślnie" sourceRef="Gateway_04" targetRef="Task_07">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_16'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_07" targetRef="EndEvent_1" />
  </bpmn:process>
