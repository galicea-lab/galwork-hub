    <bpmn:sequenceFlow id="Flow_7" name="Po podpisaniu" sourceRef="Task_03" targetRef="Task_04" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_05" targetRef="EndEvent_1" />
  </bpmn:process>
