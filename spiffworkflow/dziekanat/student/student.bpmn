    <bpmn:sequenceFlow id="Flow_5" name="Do kosza" sourceRef="Gateway_01" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_03" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_2" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_04" targetRef="EndEvent_2" />
