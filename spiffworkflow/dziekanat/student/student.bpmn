    <bpmn:userTask id="Task_03" name="Archiwum" />
    <bpmn:userTask id="Task_04" name="Kosz" />
    <bpmn:sequenceFlow id="Flow_1" name="Załóż Teczkę" sourceRef="StartEvent_main" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Dane studenta)" default="Flow_3" />
