  <bpmn:process id="Process_Zlecenie_KOOS" name="Zlecenie KOOS" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Zlecenie" />
    <bpmn:userTask id="Task_02" name="KOS do wygenerowania" />
    <bpmn:callActivity id="Task_03" name="Wysłane do podpisu" calledElement="Process_Podpis_dokumentu" />
    <bpmn:userTask id="Task_04" name="Gotowe - utworzono KOS" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Zlecenie generowania" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_3" name="Potwierdzenie wysłania" sourceRef="Task_02" targetRef="Task_03" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Wysłane do podpisu)" default="Flow_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_03" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_4" name="Podpisane" sourceRef="Gateway_01" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_6" name="Wróć" sourceRef="Gateway_01" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">wynik_podpisu == 'odrzucony'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_04" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
