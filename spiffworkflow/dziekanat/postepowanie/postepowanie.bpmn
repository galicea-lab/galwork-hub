<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_Process_Postepowanie" targetNamespace="http://bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0"
                   xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core">
  <bpmn:process id="Process_Postepowanie" name="Postępowanie" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Postepowanie">
      <bpmn:lane id="Lane_Rektor" name="Rektor">
        <bpmn:flowNodeRef>Task_04</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Wskazanie przesłanki do wszczęcia postępowania" />
    <bpmn:userTask id="Task_02" name="Uzupełnienie danych studenta" />
    <bpmn:userTask id="Task_05" name="Weryfikacja" />
    <bpmn:userTask id="Task_03" name="Wnioskowanie o wszęcie postepowania" />
    <bpmn:userTask id="Task_04" name="Decyzja i podpis Rektora" ><spiffworkflow:property name="lane" value="Rektor" /></bpmn:userTask>
    <bpmn:userTask id="Task_07" name="Doręczanie" />
    <bpmn:userTask id="Task_08" name="Obsługa doręczania" />
    <bpmn:userTask id="Task_09" name="Czekanie na odwołanie" />
    <bpmn:userTask id="Task_11" name="Przyszło odwołanie" />
    <bpmn:callActivity id="Task_10" name="Realizacja Procedury Skreślenia" calledElement="Process_Realizacja_procedury_skreslenia" />
    <bpmn:userTask id="Task_06" name="Anulowanie zadania" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Pobierz dane studenta" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Uzupełnienie danych studenta)" default="Flow_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_02" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_3" name="Przekaż do Dziekana" sourceRef="Gateway_01" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_5" name="Anulowanie" sourceRef="Gateway_01" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_04" name="Wybór ścieżki (Weryfikacja)" default="Flow_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_05" targetRef="Gateway_04" />
    <bpmn:sequenceFlow id="Flow_8" name="Anuluj" sourceRef="Gateway_04" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_8'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Do Rektora" sourceRef="Gateway_04" targetRef="Task_04" />
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Wnioskowanie o wszęcie postepowania)" default="Flow_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_03" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_9" name="Akceptuję" sourceRef="Gateway_02" targetRef="Task_04" />
    <bpmn:sequenceFlow id="Flow_11" name="Nie akceptuję" sourceRef="Gateway_02" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Decyzja i podpis Rektora)" default="Flow_12" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_04" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_14" name="Do powtórnej weryfikacji" sourceRef="Gateway_03" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_14'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="Akceptacja" sourceRef="Gateway_03" targetRef="Task_07" />
    <bpmn:exclusiveGateway id="Gateway_05" name="Wybór ścieżki (Doręczanie)" default="Flow_15" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_07" targetRef="Gateway_05" />
    <bpmn:sequenceFlow id="Flow_17" name="Problemy z wysłaniem" sourceRef="Gateway_05" targetRef="Task_08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_17'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" name="Wysyłanie zakończone pomyślnie" sourceRef="Gateway_05" targetRef="Task_09" />
    <bpmn:sequenceFlow id="Flow_18" name="Nie uruchomiono wysyłania" sourceRef="Gateway_05" targetRef="Task_08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_18'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="Wróć do Rektora" sourceRef="Gateway_05" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_19'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" name="Do wysłania" sourceRef="Task_08" targetRef="Task_07" />
    <bpmn:exclusiveGateway id="Gateway_06" name="Wybór ścieżki (Czekanie na odwołanie)" default="Flow_21" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_09" targetRef="Gateway_06" />
    <bpmn:sequenceFlow id="Flow_23" name="Skreślenie bez odwołania" sourceRef="Gateway_06" targetRef="Task_10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_23'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Rejestruj odwołanie" sourceRef="Gateway_06" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_24" name="skreślenie z odwołaniem" sourceRef="Task_11" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_10" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_06" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
  </bpmn:process>
