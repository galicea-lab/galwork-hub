<bpmn:process id="Process_Karta_obiegowa" name="Karta obiegowa" isExecutable="true">
<bpmn:laneSet id="LaneSet_Karta_obiegowa">
  <bpmn:lane id="Lane_BOS" name="BOS">
    <bpmn:flowNodeRef>Task_04</bpmn:flowNodeRef>
  </bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="StartEvent_main" name="Start">
  <bpmn:extensionElements>
    <spiffworkflow:properties>
      <spiffworkflow:property name="formJsonSchemaFilename" value="karta-obiegowa-ko-schema.json" />
      <spiffworkflow:property name="formUiSchemaFilename" value="karta-obiegowa-ko-uischema.json" />
    </spiffworkflow:properties>
  </bpmn:extensionElements>
</bpmn:startEvent>
<bpmn:userTask id="Task_02" name="Uzupełnienie danych" ><spiffworkflow:property name="formJsonSchemaFilename" value="karta-obiegowa-ko-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="karta-obiegowa-ko-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_03" name="Weryfikacja zaległości" ><spiffworkflow:property name="formJsonSchemaFilename" value="karta-obiegowa-ko-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="karta-obiegowa-ko-uischema.json" /></bpmn:userTask>
<bpmn:userTask id="Task_04" name="BOS" ><spiffworkflow:property name="formJsonSchemaFilename" value="karta-obiegowa-ko-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="karta-obiegowa-ko-uischema.json" /><spiffworkflow:property name="lane" value="BOS" /></bpmn:userTask>
<bpmn:userTask id="Task_05" name="Końcowy (pozytywny)" ><spiffworkflow:property name="formJsonSchemaFilename" value="karta-obiegowa-ko-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="karta-obiegowa-ko-uischema.json" /></bpmn:userTask>
<bpmn:sequenceFlow id="Flow_1" name="Zainicjuj" sourceRef="StartEvent_main" targetRef="Task_02" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Task_02" targetRef="Task_03" name="Przekaż do podpisu" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Task_03" targetRef="Task_04" name="Przekaż" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Task_04" targetRef="Task_05" name="Przekaż" />
<bpmn:endEvent id="EndEvent_1" name="Koniec" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Task_05" targetRef="EndEvent_1" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_Process_Karta_obiegowa">
<bpmndi:BPMNPlane id="Plane_Process_Karta_obiegowa" bpmnElement="Process_Karta_obiegowa">
<bpmndi:BPMNShape id="Shape_StartEvent_main" bpmnElement="StartEvent_main"><dc:Bounds x="60" y="82" width="36" height="36" /></bpmndi:BPMNShape>
