{#- Arkusz stylów druków (A4, druk czarno-biały). Osadzany w nagłówku strony. -#}
{#-  wspólna typografia i układ wszystkich druków w katalogu `gotowe/`. -#}
<style>
  @page {
    size: A4 {{ orientacja | default('portrait') }};
    margin: 18mm 18mm 20mm 20mm;
    @bottom-center { content: "Strona " counter(page) " z " counter(pages); font-size: 7.5pt; color: #444; }
    @top-right { content: string(znak-sprawy); font-size: 7.5pt; color: #666; }
  }
  html { -weasy-hyphens: auto; }
  body {
    font-family: "Times New Roman", "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 11pt; line-height: 1.42; color: #000; margin: 0;
    hyphens: auto; text-align: justify;
  }
  .arkusz { max-width: 174mm; margin: 0 auto; }

  /* ── nagłówek pisma ─────────────────────────────────────────────────── */
  .naglowek {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 8mm; padding-bottom: 3mm; border-bottom: 1.2pt solid #000; margin-bottom: 7mm;
  }
  .nadawca { display: flex; gap: 4mm; align-items: flex-start; max-width: 100mm; }
  .logo { height: 20mm; width: auto; }
  .dane-uczelni { font-size: 9pt; line-height: 1.25; text-align: left; }
  .dane-uczelni .nazwa { font-size: 10.5pt; font-weight: bold; letter-spacing: .04em; }
  .dane-uczelni .jednostka { font-weight: bold; }
  .metryka { text-align: right; font-size: 9pt; line-height: 1.3; white-space: nowrap; }
  .metryka .znak { font-weight: bold; margin-top: 1.5mm; }

  /* ── adresat ────────────────────────────────────────────────────────── */
  .adresat { margin: 0 0 6mm 0; font-size: 10pt; line-height: 1.35; text-align: left; }
  .adresat .pogrubienie { font-weight: bold; }
  .adresat .do-rek { float: right; text-align: right; font-size: 9pt; color: #222; }

  /* ── tytuł dokumentu ────────────────────────────────────────────────── */
  .tytul-blok { text-align: center; margin: 0 0 6mm; }
  h1.tytul { font-size: 13pt; font-weight: bold; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
  .podtytul { font-size: 10.5pt; font-style: italic; margin: 1mm 0 0; text-align: center; }
  .nr-dokumentu { font-size: 10pt; margin: 2mm 0 0; text-align: center; }
  .oznaczenie { font-size: 8.5pt; color: #222; text-align: right; margin: 0 0 2mm; }
  .cecha { font-size: 9pt; font-style: italic; margin: 0 0 4mm; text-align: left; }

  /* ── treść ──────────────────────────────────────────────────────────── */
  p { margin: 0 0 2.6mm; }
  .lead { margin: 0 0 4mm; }
  .wyrownanie-prawo { text-align: right; }
  .wyrownanie-srodek { text-align: center; }
  .wyrownanie-lewo { text-align: left; }
  .formula {
    text-align: center; font-weight: bold; letter-spacing: .22em; text-transform: uppercase;
    margin: 5mm 0; font-size: 12pt;
  }
  h2.sekcja {
    font-size: 10.5pt; font-weight: bold; letter-spacing: .14em; text-transform: uppercase;
    margin: 5mm 0 2mm; page-break-after: avoid;
  }
  h3.podsekcja { font-size: 10.5pt; font-weight: bold; margin: 3.5mm 0 1.5mm; page-break-after: avoid; }
  ul, ol { margin: 0 0 3mm 0; padding-left: 6mm; }
  li { margin: 0 0 1.2mm; }
  ul.zwykle { list-style: none; padding-left: 0; }
  small, .drobny { font-size: 8.5pt; }
  .wypelnienie { border-bottom: .6pt dotted #333; padding: 0 .5mm; }
  .linia { border-bottom: .6pt solid #333; display: inline-block; }
  blockquote { margin: 0 0 3mm 6mm; padding-left: 3mm; border-left: .8pt solid #999; font-size: 10pt; }
  .cytat { font-style: italic; }

  /* ── pola formularza ────────────────────────────────────────────────── */
  .siatka { display: grid; gap: 1.5mm 7mm; margin: 0 0 4mm; }
  .siatka.kol-1 { grid-template-columns: 1fr; }
  .siatka.kol-2 { grid-template-columns: 1fr 1fr; }
  .siatka.kol-3 { grid-template-columns: 1fr 1fr 1fr; }
  .pole { margin: 0; display: flex; gap: 1.5mm; align-items: baseline; text-align: left; }
  .pole .etykieta { white-space: nowrap; }
  .pole .wartosc {
    flex: 1; border-bottom: .6pt dotted #444; min-height: 4.6mm; display: inline-block; padding: 0 .6mm;
  }
  .pole.para .wartosc { border-bottom: none; }
  .wybor { margin-right: 4mm; white-space: nowrap; }

  /* ── tabele ─────────────────────────────────────────────────────────── */
  table.tabela { width: 100%; border-collapse: collapse; font-size: 9.5pt; margin: 0 0 4mm; }
  table.tabela th, table.tabela td {
    border: .6pt solid #000; padding: 1.2mm 1.6mm; text-align: left; vertical-align: top;
  }
  table.tabela thead th { background: #ededed; font-weight: bold; }
  table.tabela tfoot td { background: #f6f6f6; font-weight: bold; }
  table.tabela td.liczba, table.tabela th.liczba { text-align: right; }
  table.tabela.kompaktowa { font-size: 8.5pt; }
  table.tabela.krzyzowa td { height: 6mm; }
  .tab-podpis { font-size: 8.5pt; color: #333; margin-top: -2mm; margin-bottom: 4mm; }

  /* ── ramki, adnotacje ───────────────────────────────────────────────── */
  .ramka { border: .8pt solid #000; padding: 1.5mm 3mm; margin: 0 0 4mm; font-size: 10pt; }
  .ramka-tytul { font-weight: bold; margin-bottom: 1mm; }
  .adnotacje { margin: 4mm 0 0; font-size: 9pt; }
  .adnotacja { display: flex; gap: 2mm; min-height: 5.5mm; align-items: baseline; }
  .adnotacja .etykieta { white-space: nowrap; }
  .adnotacja .wartosc { flex: 1; border-bottom: .6pt dotted #444; }
  ol.zalaczniki { font-size: 10pt; }

  /* ── pouczenie ──────────────────────────────────────────────────────── */
  .pouczenie { font-size: 9.5pt; line-height: 1.35; margin: 4mm 0 0; }
  .pouczenie h2.sekcja { font-size: 9.5pt; }
  .pouczenie p { margin-bottom: 1.8mm; }

  /* ── podpisy ────────────────────────────────────────────────────────── */
  .podpisy { display: flex; justify-content: space-between; gap: 6mm; margin: 10mm 0 0; page-break-inside: avoid; }
  .podpisy.pionowo { flex-direction: column; align-items: flex-end; }
  .podpis { flex: 1; text-align: center; font-size: 9pt; }
  .podpis .osoba { min-height: 3mm; font-size: 9.5pt; }
  .podpis .linia-podpisu { border-top: .6pt solid #000; margin: 8mm 0 1.2mm; }
  .podpis .rola { font-size: 8.5pt; }
  .podpis .data { font-size: 8.5pt; margin-top: .6mm; }
  .podpis.duzy { flex: 0 0 62mm; margin-left: auto; }
  .pieczec { font-size: 8pt; color: #444; text-align: center; margin-top: 1mm; }

  /* ── klauzula RODO ──────────────────────────────────────────────────── */
  .rodo {
    font-size: 7.4pt; line-height: 1.3; color: #222; text-align: justify;
    border-top: .6pt solid #666; padding-top: 2mm; margin-top: 7mm; page-break-inside: avoid;
  }
  .rodo-tytul { font-weight: bold; margin-bottom: 1mm; text-transform: uppercase; letter-spacing: .04em; }
  .rodo ol { padding-left: 4mm; margin: 0; }
  .rodo p { margin: 0 0 1mm; }

  /* ── stopka ─────────────────────────────────────────────────────────── */
  .stopka {
    display: flex; justify-content: space-between; gap: 4mm;
    border-top: .6pt solid #000; margin-top: 8mm; padding-top: 1.5mm;
    font-size: 7.5pt; color: #333; text-align: left;
  }
  .stopka .srodek { text-align: center; }
  .stopka .prawa { text-align: right; }
  .string-znak { string-set: znak-sprawy content(); display: none; }

  /* ── podział stron ──────────────────────────────────────────────────── */
  .nowa-strona { page-break-before: always; }
  h1.tytul, .tytul-blok, .naglowek { page-break-after: avoid; }
  .podpisy, .rodo, .stopka, table.tabela { page-break-inside: avoid; }
  table.tabela thead { display: table-header-group; }

  /* ── podgląd na ekranie ─────────────────────────────────────────────── */
  @media screen {
    body { background: #e8e8e8; padding: 8mm 0; }
    .arkusz { background: #fff; padding: 18mm 20mm; box-shadow: 0 0 6px rgba(0,0,0,.25); max-width: 210mm; }
  }
</style>
