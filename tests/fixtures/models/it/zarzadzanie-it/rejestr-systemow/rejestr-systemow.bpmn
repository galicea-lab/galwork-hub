<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="defs_Process_Rejestr_systemow" targetNamespace="http://bpmn">
  <bpmn:process id="Process_Rejestr_systemow" name="Rejestr systemów i usług IT" isExecutable="true">
    <bpmn:documentation>Rejestr systemów i usług IT organizacji: właściciel, dostawca, lokalizacja danych, dane osobowe, umowa powierzenia, kopie zapasowe, dostęp. Źródło dla rejestru czynności przetwarzania (rodo/definicja-czynnosci), umów powierzenia i analizy ryzyka (scenariusz S0 - fundamenty). Jeden wpis = jedna instancja, która pozostaje w rejestrze: wpis przy starcie, przegląd (grupa it), potem krok „Wpis w rejestrze” – aktualizacja („Zapisz zmiany”, wraca do wpisu) albo „Wycofaj z rejestru” (koniec). Karta obiektu i edycja: galwork.record_step / edit_step w process_model.json.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_main" name="Nowy wpis">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="rejestr-systemow-rej-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="rejestr-systemow-rej-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_01" name="Przegląd wpisu" camunda:candidateGroups="it">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="rejestr-systemow-rej-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="rejestr-systemow-rej-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Wpis w rejestrze" camunda:candidateGroups="it">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="rejestr-systemow-rej-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="rejestr-systemow-rej-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Rejestr" name="Wybór ścieżki (Wpis w rejestrze)" default="Flow_Zapisz" />
    <bpmn:endEvent id="End_Wycofany" name="Wpis wycofany" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_02" targetRef="GW_Rejestr" />
    <bpmn:sequenceFlow id="Flow_Zapisz" name="Zapisz zmiany" sourceRef="GW_Rejestr" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_Wycofaj" name="Wycofaj z rejestru" sourceRef="GW_Rejestr" targetRef="End_Wycofany">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_Wycofaj'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Rejestr_systemow">
    <bpmndi:BPMNPlane id="Plane_Process_Rejestr_systemow" bpmnElement="Process_Rejestr_systemow">
      <bpmndi:BPMNShape id="StartEvent_main_di" bpmnElement="StartEvent_main"><dc:Bounds x="60" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_01_di" bpmnElement="Task_01"><dc:Bounds x="160" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_02_di" bpmnElement="Task_02"><dc:Bounds x="320" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Rejestr_di" bpmnElement="GW_Rejestr" isMarkerVisible="true"><dc:Bounds x="480" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Wycofany_di" bpmnElement="End_Wycofany"><dc:Bounds x="602" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="78" y="120" /><di:waypoint x="210" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="210" y="120" /><di:waypoint x="370" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="370" y="120" /><di:waypoint x="505" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Zapisz_di" bpmnElement="Flow_Zapisz"><di:waypoint x="505" y="95" /><di:waypoint x="505" y="40" /><di:waypoint x="370" y="40" /><di:waypoint x="370" y="80" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Wycofaj_di" bpmnElement="Flow_Wycofaj"><di:waypoint x="505" y="120" /><di:waypoint x="620" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
