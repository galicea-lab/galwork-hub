<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="defs_Process_Definicja_Planu_Rocznego"
                   targetNamespace="http://bpmn"
                   xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core">

<bpmn:process id="Process_Definicja_Planu_Rocznego" name="Definicja Planu Rocznego" isExecutable="true">
<bpmn:startEvent id="StartEvent_main" name="Start">
  <bpmn:extensionElements>
    <spiffworkflow:properties>
      <spiffworkflow:property name="formJsonSchemaFilename" value="definicja-planu-rocznego-fplan-schema.json" />
      <spiffworkflow:property name="formUiSchemaFilename" value="definicja-planu-rocznego-fplan-uischema.json" />
    </spiffworkflow:properties>
  </bpmn:extensionElements>
</bpmn:startEvent>
<bpmn:userTask id="Task_02" name="Końcowy (pozytywny)" ><spiffworkflow:property name="formJsonSchemaFilename" value="definicja-planu-rocznego-fplan-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="definicja-planu-rocznego-fplan-uischema.json" /></bpmn:userTask>
<bpmn:sequenceFlow id="Flow_1" name="Przejdź do następnego kroku" sourceRef="StartEvent_main" targetRef="Task_02" />
<bpmn:endEvent id="EndEvent_1" name="Koniec" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Task_02" targetRef="EndEvent_1" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_Process_Definicja_Planu_Rocznego">
<bpmndi:BPMNPlane id="Plane_Process_Definicja_Planu_Rocznego" bpmnElement="Process_Definicja_Planu_Rocznego">
<bpmndi:BPMNShape id="Shape_StartEvent_main" bpmnElement="StartEvent_main"><dc:Bounds x="60" y="82" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Task_02" bpmnElement="Task_02"><dc:Bounds x="500" y="60" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1"><dc:Bounds x="720" y="82" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="96" y="100" /><di:waypoint x="500" y="100" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="600" y="100" /><di:waypoint x="720" y="100" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane>
</bpmndi:BPMNDiagram>
</bpmn:definitions>