<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="defs_Process_Dokumenty" targetNamespace="http://bpmn">
  <bpmn:process id="Process_Dokumenty" name="Dokumenty" isExecutable="true">
    <bpmn:startEvent id="StartEvent_main" name="Start">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_02" name="Repozytorium dokumentów">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_07" name="Zmiana statusu">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Zmiany">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Weryfikacja">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_05" name="Przygotowanie uchylenia">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_06" name="Uchylony">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="dokumenty-uz-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="dokumenty-uz-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="Service_Dokument" name="Dokument główny">
      <bpmn:documentation>treść aktu w repozytorium - dokument huba (wersje, sha256, Paperless). Przy rejestracji z obiegu "Przygotuj zarządzenie" przychodzi `dokument_id` i dokument zostaje dołączony do tej sprawy; przy rejestracji ręcznej krok czeka, aż użytkownik doda plik do sprawy ("Sprawdź teraz"). Obsługa: galwork-hub wf/services/signing_service.py::main_document.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="dokumenty.glowny" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" name="Rejestracja dokumentu" sourceRef="StartEvent_main" targetRef="Service_Dokument" />
    <bpmn:serviceTask id="Service_Od" name="Obowiązuje od">
      <bpmn:documentation>data wejścia w życie bieżącej wersji aktu (redakcji). Gdy akt ma oczekującą zmianę (relacja "zmienia" bez tekstu jednolitego), nowa wersja staje się tekstem jednolitym z datą zmiany. Redakcje muszą następować po sobie. Obsługa: galwork-hub wf/services/legal_acts.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="akty.obowiazuje_od" />
          <spiffworkflow:property name="dateField" value="Obowiązuje od, Data wydania" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Relacje" name="Zmiany i uchylenia aktów">
      <bpmn:documentation>relacje aktu rejestrowanego w repozytorium - "zmienia"/"uchyla" akty z repozytorium od daty "Obowiązuje od" (rejestracja ręczna albo zmiany w repozytorium). Przy rejestracji z obiegu zarządzenia relacje są już zapisane - krok ich nie dubluje. Obsługa: galwork-hub wf/services/legal_acts.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="akty.relacje" />
          <spiffworkflow:property name="dateField" value="Obowiązuje od, Data wydania" />
          <spiffworkflow:property name="amendsField" value="Zmienia akty" />
          <spiffworkflow:property name="repealsField" value="Uchyla akty" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Pieczec" name="Pieczęć elektroniczna">
      <bpmn:documentation>pieczęć PAdES (galwork-seal) na bieżącej wersji dokumentu - wynik to kolejna wersja tego samego dokumentu. Krok idempotentny: dokument już opieczętowany nie jest pieczętowany ponownie. Bez PDF albo przy wyłączonej pieczęci krok czeka. Źródło zlecenia dla polityki galwork-seal: regulacje. Obsługa: galwork-hub wf/services/seal_service_tasks.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="pieczec.dokument" />
          <spiffworkflow:property name="source" value="regulacje" />
          <spiffworkflow:property name="reason" value="Akt wewnętrzny zarejestrowany w repozytorium dokumentów" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1b" sourceRef="Service_Dokument" targetRef="Service_Od" />
    <bpmn:sequenceFlow id="Flow_1d" sourceRef="Service_Od" targetRef="Service_Relacje" />
    <bpmn:sequenceFlow id="Flow_1e" sourceRef="Service_Relacje" targetRef="Service_Pieczec" />
    <bpmn:sequenceFlow id="Flow_1c" sourceRef="Service_Pieczec" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Repozytorium dokumentów)" default="Flow_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_02" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_3" name="Inicjuj zmiany" sourceRef="Gateway_01" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_5" name="Zmień Status" sourceRef="Gateway_01" targetRef="Task_07">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" name="Uchylenie" sourceRef="Gateway_01" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_6'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8" name="Zapisz" sourceRef="Gateway_01" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_8'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="Ogranicz dostęp" sourceRef="Gateway_01" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_9'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Zapisz zmiany" sourceRef="Task_07" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Zmiany)" default="Flow_12" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_03" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_12" name="Rejestruj zmiany" sourceRef="Gateway_02" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_14" name="Do weryfikacji" sourceRef="Gateway_02" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_14'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Weryfikacja)" default="Flow_15" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_04" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_15" name="Do uchylenia" sourceRef="Gateway_03" targetRef="Task_05" />
    <bpmn:sequenceFlow id="Flow_17" name="Akceptacja zmian" sourceRef="Gateway_03" targetRef="Service_Od">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_17'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_18" name="Uchylony" sourceRef="Task_05" targetRef="Task_06" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_06" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Dokumenty">
    <bpmndi:BPMNPlane id="Plane_Process_Dokumenty" bpmnElement="Process_Dokumenty">
      <bpmndi:BPMNShape id="Shape_StartEvent_main" bpmnElement="StartEvent_main">
