<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core" id="defs_Process_Przygotuj_zarzadzenie" targetNamespace="http://bpmn">
  <bpmn:process id="Process_Przygotuj_zarzadzenie" name="Przygotuj zarządzenie" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Przygotuj_zarzadzenie">
      <bpmn:lane id="Lane_IOD" name="IOD">
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_main" name="Start" />
    <bpmn:userTask id="Task_01" name="Opis zarządzenia">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_02" name="Przygotowanie zarządzenia">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_03" name="Konsultacje merytoryczne">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_11" name="Konsultacje z IOD">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
          <spiffworkflow:property name="lane" value="IOD" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_12" name="Opinia prawna">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_05" name="Akceptacja">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_06" name="Publikacja">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_10" name="Na BIP">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_08" name="Do wykonania">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_09" name="Generuj zadania do potwierdzenia">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_07" name="Archiwum">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="Task_04" name="Anulowane przed publikacją">
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="formJsonSchemaFilename" value="przygotuj-zarzadzenie-f-zr-schema.json" />
          <spiffworkflow:property name="formUiSchemaFilename" value="przygotuj-zarzadzenie-f-zr-uischema.json" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_main" targetRef="Task_01" />
    <bpmn:exclusiveGateway id="Gateway_01" name="Wybór ścieżki (Opis zarządzenia)" default="Flow_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_01" targetRef="Gateway_01" />
    <bpmn:sequenceFlow id="Flow_2" name="Przygotowanie" sourceRef="Gateway_01" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_4" name="Zapisz" sourceRef="Gateway_01" targetRef="Task_01">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_4'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" name="Publikacja" sourceRef="Gateway_01" targetRef="Task_06">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_5'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_02" name="Wybór ścieżki (Przygotowanie zarządzenia)" default="Flow_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_02" targetRef="Gateway_02" />
    <bpmn:sequenceFlow id="Flow_6" name="Opinia merytoryczna" sourceRef="Gateway_02" targetRef="Task_03" />
    <bpmn:sequenceFlow id="Flow_8" name="Anuluj" sourceRef="Gateway_02" targetRef="Task_04">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_8'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" name="Gotowe do akceptacji" sourceRef="Gateway_02" targetRef="Task_05">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_9'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="Konsultacje z IOD" sourceRef="Gateway_02" targetRef="Task_11">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_10'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="Konsultacje z prawnikiem" sourceRef="Gateway_02" targetRef="Task_12">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_11'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="Przekaż opinię" sourceRef="Task_03" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_13" name="Przekaż opinię IOD" sourceRef="Task_11" targetRef="Task_02" />
    <bpmn:sequenceFlow id="Flow_14" name="Przekaż opinię prawną" sourceRef="Task_12" targetRef="Task_02" />
    <bpmn:exclusiveGateway id="Gateway_03" name="Wybór ścieżki (Akceptacja)" default="Flow_15" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_05" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_15" name="Akceptuj" sourceRef="Gateway_03" targetRef="Task_06" />
    <bpmn:sequenceFlow id="Flow_17" name="Zwróć" sourceRef="Gateway_03" targetRef="Task_02">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_17'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_04" name="Wybór ścieżki (Publikacja)" default="Flow_18" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_06" targetRef="Gateway_04" />
    <bpmn:sequenceFlow id="Flow_18" name="Do archiwum" sourceRef="Gateway_04" targetRef="Task_07" />
    <bpmn:sequenceFlow id="Flow_20" name="Do wykonania" sourceRef="Gateway_04" targetRef="Task_08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_20'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Zapis do rejestru" sourceRef="Gateway_04" targetRef="Service_Dokument">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_21'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Service_Dokument" name="Dokument zarządzenia">
      <bpmn:documentation>główny dokument tej sprawy (wydruk zarządzenia albo wgrany plik) - `dokument_id` dla rejestracji w repozytorium. Brak dokumentu: krok czeka ("Sprawdź teraz" po dodaniu pliku). Obsługa: galwork-hub wf/services/signing_service.py::main_document.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="dokumenty.glowny" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Relacje" name="Zmiany i uchylenia aktów">
      <bpmn:documentation>relacje publikowanego aktu - "zmienia"/"uchyla" akty z repozytorium od daty wejścia w życie; status prawny aktów docelowych wylicza hub (GET /v1/wf/acts/{id}?on=). Obsługa: galwork-hub wf/services/legal_acts.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="akty.relacje" />
          <spiffworkflow:property name="dateField" value="Szczegóły dokumentu.Od kiedy obowiązuje" />
          <spiffworkflow:property name="amendsField" value="Szczegóły dokumentu.Zmienia akty" />
          <spiffworkflow:property name="repealsField" value="Szczegóły dokumentu.Uchyla akty" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_Rejestr" name="Rejestracja w repozytorium">
      <bpmn:documentation>zastępuje podobieg Webcon "Repozytorium dokumentów" - osobna instancja `regulacje/dokumenty` (żyje do uchylenia aktu), z tym samym dokumentem (wersje, sha256), nie kopią. `startOnce`: powtórny zapis nie zakłada drugiej sprawy (chyba że poprzednia została anulowana); nowe wersje dokumentu są widoczne w repozytorium bez ponownej rejestracji.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="startProcess" value="dokumenty" />
          <spiffworkflow:property name="startOnce" value="true" />
          <spiffworkflow:property name="startInput" value="dokument_id-&gt;dokument_id, Szczegóły dokumentu.Tytuł-&gt;Tytuł dokumentu, Szczegóły dokumentu.Nr dokumentu-&gt;Nr dokumentu, Szczegóły dokumentu.Typ dokumentu-&gt;Typ dokumentu, Szczegóły dokumentu.Data wydania-&gt;Data wydania, Szczegóły dokumentu.Słowa kluczowe-&gt;Słowa kluczowe, Szczegóły dokumentu.Status-&gt;Status, Szczegóły dokumentu.Od kiedy obowiązuje-&gt;Obowiązuje od, Szczegóły dokumentu.Zmienia akty-&gt;Zmienia akty, Szczegóły dokumentu.Uchyla akty-&gt;Uchyla akty" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Service_Od" name="Obowiązuje od">
      <bpmn:documentation>data wejścia w życie bieżącej wersji aktu (redakcji). Gdy akt ma oczekującą zmianę (relacja "zmienia" bez tekstu jednolitego), nowa wersja staje się tekstem jednolitym z datą zmiany. Redakcje muszą następować po sobie. Obsługa: galwork-hub wf/services/legal_acts.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="akty.obowiazuje_od" />
          <spiffworkflow:property name="dateField" value="Szczegóły dokumentu.Od kiedy obowiązuje" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_Pieczec" name="Pieczęć elektroniczna">
      <bpmn:documentation>pieczęć PAdES (galwork-seal) na bieżącej wersji dokumentu - wynik to kolejna wersja tego samego dokumentu. Krok idempotentny: dokument już opieczętowany nie jest pieczętowany ponownie. Bez PDF albo przy wyłączonej pieczęci krok czeka. Źródło zlecenia dla polityki galwork-seal: regulacje. Obsługa: galwork-hub wf/services/seal_service_tasks.py.</bpmn:documentation>
      <bpmn:extensionElements>
        <spiffworkflow:properties>
          <spiffworkflow:property name="handler" value="pieczec.dokument" />
          <spiffworkflow:property name="source" value="regulacje" />
          <spiffworkflow:property name="reason" value="Zarządzenie opublikowane w repozytorium dokumentów" />
          <spiffworkflow:property name="retryMinutes" value="60" />
        </spiffworkflow:properties>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_21b" sourceRef="Service_Dokument" targetRef="Service_Od" />
    <bpmn:sequenceFlow id="Flow_21e" sourceRef="Service_Od" targetRef="Service_Pieczec" />
    <bpmn:sequenceFlow id="Flow_21d" sourceRef="Service_Pieczec" targetRef="Service_Relacje" />
    <bpmn:sequenceFlow id="Flow_21f" sourceRef="Service_Relacje" targetRef="Send_Rejestr" />
    <bpmn:sequenceFlow id="Flow_21c" sourceRef="Send_Rejestr" targetRef="Task_06" />
    <bpmn:sequenceFlow id="Flow_22" name="Do BIP" sourceRef="Gateway_04" targetRef="Task_10">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_22'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" name="Nowa ścieżka przejścia" sourceRef="Task_10" targetRef="Task_06" />
    <bpmn:exclusiveGateway id="Gateway_05" name="Wybór ścieżki (Do wykonania)" default="Flow_24" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_08" targetRef="Gateway_05" />
    <bpmn:sequenceFlow id="Flow_24" name="Przekaż - z potwierdzeniem" sourceRef="Gateway_05" targetRef="Task_09" />
    <bpmn:sequenceFlow id="Flow_26" name="Do archiwum" sourceRef="Gateway_05" targetRef="Task_07">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">chosen_path == 'Flow_26'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" name="Potwierdzam" sourceRef="Task_09" targetRef="Task_07" />
    <bpmn:endEvent id="EndEvent_1" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_07" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_2" name="Koniec" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_04" targetRef="EndEvent_2" />
  </bpmn:process>
